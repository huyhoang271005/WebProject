<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="org.example.Feature.Feedback.FeedbackView">
  <grid id="27dc6" binding="mainPanel" layout-manager="BorderLayout" hgap="10" vgap="10">
    <constraints>
      <xy x="20" y="20" width="800" height="600"/>
    </constraints>
    <properties>
      <border type="empty">
        <size top="15" left="15" bottom="15" right="15"/>
      </border>
    </properties>
    <border type="none"/>
    <children>
      <!-- TOP PANEL: Search & User -->
      <grid id="headerParams" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="North"/>
        <properties/>
        <border type="none"/>
        <children>
          <!-- Search Panel -->
          <grid id="searchPnl" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="0">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <border type="etched" title="Tìm kiếm đơn hàng"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="lblOrder" class="javax.swing.JLabel">
                <constraints/>
                <properties>
                  <text value="Order ID:"/>
                </properties>
              </component>
              <component id="txtOrder" binding="txtOrderId" class="javax.swing.JTextField">
                <constraints/>
                <properties>
                  <columns value="30"/>
                </properties>
              </component>
              <component id="btnSearch" binding="btnSearch" class="javax.swing.JButton">
                <constraints/>
                <properties>
                  <text value="Tìm kiếm"/>
                </properties>
              </component>
            </children>
          </grid>
          <!-- User Panel -->
          <grid id="userPnl" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="0">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <border type="etched" title="Thông tin người dùng"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="lblUser" class="javax.swing.JLabel">
                <constraints/>
                <properties>
                  <text value="User ID:"/>
                </properties>
              </component>
              <component id="txtUser" binding="txtUserId" class="javax.swing.JTextField">
                <constraints/>
                <properties>
                  <columns value="30"/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </grid>

      <!-- CENTER PANEL: Product List -->
      <scrollpane id="scroll" binding="scrollProducts">
        <constraints border-constraint="Center"/>
        <properties>
          <border type="etched" title="Danh sách sản phẩm có thể đánh giá"/>
          <preferredSize width="0" height="300"/>
        </properties>
        <border type="none"/>
        <children>
          <!-- Custom create for dynamic layout -->
          <grid id="prodContent" binding="pnlProductsContainer" custom-create="true" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints/>
            <properties/>
            <border type="none"/>
            <children/>
          </grid>
        </children>
      </scrollpane>

      <!-- BOTTOM PANEL: Feedback Form -->
      <grid id="feedbackPnl" binding="pnlFeedbackForm" layout-manager="GridLayoutManager" row-count="3" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
        <margin top="5" left="5" bottom="5" right="5"/>
        <constraints border-constraint="South"/>
        <properties>
          <border type="etched" title="Form đánh giá"/>
        </properties>
        <border type="none"/>
        <children>
          <!-- Rating -->
          <component id="lblRating" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Đánh giá (1-5 sao):"/>
            </properties>
          </component>
          <component id="cbRating" binding="cbRating" class="javax.swing.JComboBox">
             <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>

          <!-- Comment -->
          <component id="lblComment" class="javax.swing.JLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="9" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Nhận xét:"/>
            </properties>
          </component>
          <scrollpane id="scrollComment">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="txtComment" binding="txtComment" class="javax.swing.JTextArea">
                <properties>
                  <columns value="30"/>
                  <lineWrap value="true"/>
                  <rows value="5"/>
                  <wrapStyleWord value="true"/>
                </properties>
              </component>
            </children>
          </scrollpane>

          <!-- Buttons -->
          <grid id="btnPnl" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="2">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="2" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="btnClear" binding="btnClear" class="javax.swing.JButton">
                <constraints/>
                <properties>
                  <text value="Xóa form"/>
                </properties>
              </component>
              <component id="btnSubmit" binding="btnSubmit" class="javax.swing.JButton">
                <constraints/>
                <properties>
                  <text value="Gửi đánh giá"/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </grid>
    </children>
  </grid>
</form>
